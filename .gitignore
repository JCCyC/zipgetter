*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz

# Debug output saved via -os (HTML source dumps)
*.html

# Scratch directory for manual tests
outdir/
